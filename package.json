{
  "name": "sprawdzarka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokalna aplikacja React + TypeScript do sprawdzania, czy kod realizuje opisane zadanie.",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "express": "^5.1.0",
    "openai": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
